# Pipeline source endpoint
ETL_SOURCE_URL= https://jsonplaceholder.typicode.com/users

# API authentication — add whichever your source API requires
ETL_API_KEY= 
ETL_API_TOKEN=
ETL_BEARER_TOKEN=

# Output destination override (optional — defaults to base_config.json)
ETL_TARGET_PATH= data/output/processed_users.csv

# Environment label: development | staging | production
ETL_ENV=development
